{
  "name": "screenrec",
  "version": "1.0.0",
  "description": "SCREENREC - Grabador de pantalla profesional con superpoderes",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"index.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"index.html\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist node_modules"
  },
  "dependencies": {
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eslendere3official-stack/Grabador-de-pantalla.git"
  },
  "keywords": [
    "screen-recorder",
    "web-app",
    "typescript",
    "mediarecorder",
    "canvas",
    "video-capture",
    "screen-capture"
  ],
  "author": "eslendere3official-stack",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/eslendere3official-stack/Grabador-de-pantalla/issues"
  },
  "homepage": "https://github.com/eslendere3official-stack/Grabador-de-pantalla",
  "engines": {
    "node": ">=20.19.0"
  }
}
